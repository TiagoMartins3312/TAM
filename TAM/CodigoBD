BASE DE DADOS 01/11

CREATE SCHEMA IF NOT EXISTS "TAM_Android";

-- Parte para compatibilidade da função crypt() usada no db.py
CREATE EXTENSION IF NOT EXISTS pgcrypto;


CREATE TABLE IF NOT EXISTS users (
    id          SERIAL PRIMARY KEY,
    username    VARCHAR(64) UNIQUE NOT NULL,
    password    TEXT NOT NULL,
    criado_em   TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS devices (
    id            SERIAL PRIMARY KEY,
    mac           VARCHAR(17) UNIQUE,
    device_token  VARCHAR(64) UNIQUE,
    name          VARCHAR(64),
    ip            VARCHAR(45),
    firmware      VARCHAR(32),
    last_seen     TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    criado_em     TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS readings (
    id           BIGSERIAL PRIMARY KEY,
    device_id    INTEGER REFERENCES devices(id) ON DELETE CASCADE,
    sensor       VARCHAR(32) NOT NULL,
    value        VARCHAR(32) NOT NULL,
    criado_em    TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS actuator_state (
    id          INTEGER PRIMARY KEY,
    fan_on      BOOLEAN NOT NULL DEFAULT false,
    fan_speed   INTEGER NOT NULL DEFAULT 0
                CHECK (fan_speed BETWEEN 0 AND 100),
    led_1       BOOLEAN NOT NULL DEFAULT false,
    led_2       BOOLEAN NOT NULL DEFAULT false,
    mode        VARCHAR(16) NOT NULL DEFAULT 'automatico'
                CHECK (mode IN ('automatico','manual','noturno')),
-- Isto está certo? Não me lembro dos modos usados
    temp_on     FLOAT NOT NULL DEFAULT 28.0,
    temp_off    FLOAT NOT NULL DEFAULT 26.0,
    updated_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- =====================================================
-- MIGRAÇÃO 20/11 - Standby pela app + estado real do Arduino
-- Correr uma vez no pgAdmin (na BD dos componentes).
-- Pode ser corrido várias vezes sem problema.
-- =====================================================

-- Comando de standby (LEDs a piscar, ventoinha desligada).
ALTER TABLE "TAM_Android".actuator_state
    ADD COLUMN IF NOT EXISTS standby BOOLEAN NOT NULL DEFAULT false;

-- Estado físico reportado pelo Arduino (separado dos comandos da app).
ALTER TABLE "TAM_Android".actuator_state
    ADD COLUMN IF NOT EXISTS fan_actual_on BOOLEAN NOT NULL DEFAULT false;
ALTER TABLE "TAM_Android".actuator_state
    ADD COLUMN IF NOT EXISTS led_1_actual BOOLEAN NOT NULL DEFAULT false;
ALTER TABLE "TAM_Android".actuator_state
    ADD COLUMN IF NOT EXISTS led_2_actual BOOLEAN NOT NULL DEFAULT false;

-- O modo manual deixou de existir.
UPDATE "TAM_Android".actuator_state
    SET mode = 'automatico'
    WHERE mode = 'manual';

-- Garantir que a linha única existe.
INSERT INTO "TAM_Android".actuator_state (id)
    VALUES (1)
    ON CONFLICT (id) DO NOTHING;
