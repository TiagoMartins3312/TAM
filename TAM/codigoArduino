// ============================================================
// MAC do próprio módulo Wi-Fi (lido em runtime, não hardcoded)
// ============================================================
char MAC_DISPOSITIVO[18];   // "AA:BB:CC:DD:EE:FF\0"

void lerMac() {
  byte mac[6];
  WiFi.macAddress(mac);
  snprintf(MAC_DISPOSITIVO, sizeof(MAC_DISPOSITIVO),
           "%02X:%02X:%02X:%02X:%02X:%02X",
           mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
}

// ligação https à Vercel
WiFiSSLClient clienteSSL;
HttpClient http(clienteSSL, API_HOST, 443);

unsigned long ultimaTentativaWiFi = 0;
unsigned long ultimaLeituraTemperatura = 0;
unsigned long ultimoEnvioAPI = 0;

bool wifiIniciado = false;
bool estavaLigadoWiFi = false;   // para logar o IP só na transição
bool temLeitura = false;
bool enviarImediatamente = true;

// estado do sistema
float temperatura = 0.0;

// true = pode ligar pela temperatura, false = desligada pela app
bool comandoVentoinhaLigada = false;
// o que a ventoinha está mesmo a fazer
bool ventoinhaLigadaReal = false;

// standby, pela app ou pelo botão
bool standby = false;
bool ledsLigados = false;

// fica true quando o botão muda o standby e ainda não avisámos a api
bool standbyPendente = false;

// botão
bool ultimaLeituraBotao = HIGH;
bool estadoBotao = HIGH;
bool botaoArmado = false;

unsigned long ultimaMudancaBotao = 0;
unsigned long ultimoPiscar = 0;


// protótipos
void ligarWiFi();
float lerTemperatura();
void controlarSistema();
void enviarTemperatura();
void processarBotao();
bool receberComandos(String resposta);
String extrairObjetoJSON(String json, String campo);
String lerCampoJSON(String json, String campo);


// liga ao wifi, se falhar volta a tentar passados 10 segundos
void ligarWiFi() {
  if (WiFi.status() == WL_CONNECTED) {
    // só loga o IP quando a ligação acabou de ser estabelecida
    if (!estavaLigadoWiFi) {
      Serial.print("Wi-Fi ligado. IP: ");
      Serial.println(WiFi.localIP());
      estavaLigadoWiFi = true;
    }
    return;
  }

  estavaLigadoWiFi = false;

  if (wifiIniciado && millis() - ultimaTentativaWiFi < 10000UL) {
    return;
  }

  ultimaTentativaWiFi = millis();
  wifiIniciado = true;

  Serial.println("A ligar ao Wi-Fi...");
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}


// ler a temperatura do TMP36
float lerTemperatura() {
  // a primeira leitura costuma vir errada, não conta
  analogRead(SENSOR);
  delay(5);

  long soma = 0;

  for (int i = 0; i < NUMERO_LEITURAS; i++) {
    soma += analogRead(SENSOR);
    delay(2);
  }

  float valorADC = (float) soma / NUMERO_LEITURAS;

  // passar para mV, referência 2.5 V, ADC de 10 bits (1024)
  float tensao = valorADC * 2500.0 / 1024.0;

  Serial.print("ADC: ");
  Serial.print(valorADC);
  Serial.print(" | Tensao: ");
  Serial.print(tensao);
  Serial.println(" mV");

  if (tensao < 100.0 || tensao > 1750.0) {
    Serial.println("AVISO: leitura do TMP36 fora do normal. Verificar ligacoes.");
  }

  // no TMP36 0 graus são 500 mV e cada grau são 10 mV
  return (tensao - 500.0) / 10.0 + AJUSTE_TEMPERATURA;
}


// ir buscar o valor de um campo ao json
String lerCampoJSON(String json, String campo) {
  String chave = "\"" + campo + "\"";

  int posicao = json.indexOf(chave);
  if (posicao < 0) return "";

  int doisPontos = json.indexOf(':', posicao + chave.length());
  if (doisPontos < 0) return "";

  int inicio = doisPontos + 1;

  while (inicio < json.length() &&
         (json.charAt(inicio) == ' '  ||
          json.charAt(inicio) == '\n' ||
          json.charAt(inicio) == '\r' ||
          json.charAt(inicio) == '\t')) {
    inicio++;
  }

  // se for texto
  if (json.charAt(inicio) == '"') {
    int fim = json.indexOf('"', inicio + 1);
    if (fim < 0) return "";
    return json.substring(inicio + 1, fim);
  }

  // se for número ou true/false
  int fim = inicio;
  while (fim < json.length() &&
         json.charAt(fim) != ',' &&
         json.charAt(fim) != '}' &&
         json.charAt(fim) != ']') {
    fim++;
  }

  String valor = json.substring(inicio, fim);
  valor.trim();
  return valor;
}


// tirar só a parte do json que está entre { }
String extrairObjetoJSON(String json, String campo) {
  String chave = "\"" + campo + "\"";

  int posicao = json.indexOf(chave);
  if (posicao < 0) return "";

  int inicio = json.indexOf('{', posicao);
  if (inicio < 0) return "";

  int fim = json.indexOf('}', inicio);
  if (fim < 0) return "";

  return json.substring(inicio, fim + 1);
}


// ler os comandos da app que vêm na resposta da api
bool receberComandos(String resposta) {
  String atuadores = extrairObjetoJSON(resposta, "actuators");

  if (atuadores.length() == 0) {
    Serial.println("ERRO: resposta sem objeto actuators.");
    return false;
  }

  String novoEstado  = lerCampoJSON(atuadores, "fan_on");
  String novoStandby = lerCampoJSON(atuadores, "standby");

  if (novoEstado.length() == 0 || novoStandby.length() == 0) {
    Serial.println("ERRO: comandos incompletos.");
    return false;
  }

  comandoVentoinhaLigada = (novoEstado == "true");

  bool standbyDaApp = (novoStandby == "true");

  if (standbyDaApp != standby) {
    standby = standbyDaApp;
    ledsLigados = false;
    ultimoPiscar = millis();

    Serial.println(standby ? "STANDBY ATIVADO PELA APP"
                           : "STANDBY DESATIVADO PELA APP");
  }

  Serial.println("----------------------------");
  Serial.println("COMANDOS RECEBIDOS DA APP");

  Serial.print("Ventoinha: ");
  Serial.println(comandoVentoinhaLigada ? "PERMITIDA (AUTOMATICO)"
                                        : "DESLIGADA PELA APP");

  Serial.print("Standby: ");
  Serial.println(standby ? "SIM" : "NAO");

  Serial.println("----------------------------");

  return true;
}


// controlar a ventoinha (relé) e os leds
void controlarSistema() {
  // em standby a ventoinha fica desligada
  if (standby) {
    digitalWrite(RELE, RELE_DESLIGADO);
    ventoinhaLigadaReal = false;
    return;
  }

  // só liga se a app deixar e se a temperatura passar o limite
  bool ligarVentoinha = comandoVentoinhaLigada && temperatura > LIMITE_TEMPERATURA;

  digitalWrite(RELE, ligarVentoinha ? RELE_LIGADO : RELE_DESLIGADO);
  ventoinhaLigadaReal = ligarVentoinha;

  // vermelho = quente, verde = normal
  if (temperatura > LIMITE_TEMPERATURA) {
    digitalWrite(LED_VERDE, LOW);
    digitalWrite(LED_VERMELHO, HIGH);
  } else {
    digitalWrite(LED_VERDE, HIGH);
    digitalWrite(LED_VERMELHO, LOW);
  }
}


// enviar a temperatura para a api e receber os comandos
void enviarTemperatura() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi desligado.");
    return;
  }

  // criar o json à mão
  String json = "{\"sensor\":\"TMP36\",\"value\":";
  json += String(temperatura, 2);

  json += ",\"mac\":\"";
  json += MAC_DISPOSITIVO;
  json += "\"";

  json += ",\"device_token\":\"";
  json += API_TOKEN;
  json += "\"";

  // estado real da ventoinha
  json += ",\"fan_actual_on\":";
  json += (ventoinhaLigadaReal ? "true" : "false");

  json += ",\"led_1\":";
  json += (digitalRead(LED_VERDE) ? "true" : "false");

  json += ",\"led_2\":";
  json += (digitalRead(LED_VERMELHO) ? "true" : "false");

  // o standby só vai quando foi o botão a mudar
  if (standbyPendente) {
    json += ",\"standby\":";
    json += (standby ? "true" : "false");
  }

  json += "}";

  Serial.println("A enviar dados para a API...");
  Serial.println(json);

  http.setHttpResponseTimeout(10000);

  http.beginRequest();
  http.post(API_CAMINHO);
  http.sendHeader("Content-Type", "application/json");
  http.sendHeader("Content-Length", json.length());
  http.sendHeader("Authorization", String("Bearer ") + API_TOKEN);
  http.beginBody();
  http.print(json);
  http.endRequest();

  int codigoHTTP = http.responseStatusCode();

  Serial.print("Codigo HTTP: ");
  Serial.println(codigoHTTP);

  String resposta = http.responseBody();

  Serial.println("Resposta da API:");
  Serial.println(resposta);

  http.stop();

  if (codigoHTTP == 201 || codigoHTTP == 200) {
    // a api já guardou o standby do botão
    standbyPendente = false;

    bool ventoinhaAntes = ventoinhaLigadaReal;
    bool standbyAntes   = standby;

    if (receberComandos(resposta)) {
      controlarSistema();

      Serial.println("Comandos aplicados no Arduino.");

      // se mudou alguma coisa envia logo outra vez
      if (ventoinhaLigadaReal != ventoinhaAntes || standby != standbyAntes) {
        enviarImediatamente = true;
      }
    }
  } else {
    Serial.println("Erro na comunicacao com a API.");
  }
}


// botão do standby
void processarBotao() {
  bool leitura = digitalRead(BOTAO);
  unsigned long agora = millis();

  if (leitura != ultimaLeituraBotao) {
    ultimaLeituraBotao = leitura;
    ultimaMudancaBotao = agora;
  }

  // debounce de 50 ms
  if (agora - ultimaMudancaBotao >= 50) {
    if (leitura != estadoBotao) {
      estadoBotao = leitura;

      if (estadoBotao == HIGH) {
        botaoArmado = true;
      }

      if (estadoBotao == LOW && botaoArmado) {
        botaoArmado = false;
        standby = !standby;
        ledsLigados = false;
        ultimoPiscar = agora;

        // avisar a api para a app ficar igual
        standbyPendente = true;
        enviarImediatamente = true;

        if (standby) {
          Serial.println("STANDBY ATIVO (BOTAO)");
        } else {
          temLeitura = false;
          Serial.println("STANDBY DESATIVADO (BOTAO)");
        }

        controlarSistema();
      }
    }
  }
}


void setup() {
  Serial.begin(115200);

  // referência interna de 2.5 V para a leitura ser mais certa
  analogReference(INTERNAL2V5);

  // primeira leitura (descartada)
  analogRead(SENSOR);

  // pinos
  pinMode(BOTAO, INPUT_PULLUP);
  pinMode(LED_VERDE, OUTPUT);
  pinMode(LED_VERMELHO, OUTPUT);
  pinMode(RELE, OUTPUT);

  // estado inicial
  digitalWrite(LED_VERDE, LOW);
  digitalWrite(LED_VERMELHO, LOW);
  digitalWrite(RELE, RELE_DESLIGADO);

  estadoBotao = digitalRead(BOTAO);
  ultimaLeituraBotao = estadoBotao;
  botaoArmado = (estadoBotao == HIGH);
  ultimaMudancaBotao = millis();

  if (WiFi.status() == WL_NO_MODULE) {
    Serial.println("ERRO: modulo Wi-Fi nao encontrado.");
  } else {
    // MAC real do módulo — sem hardcoded
    lerMac();
    Serial.print("MAC do dispositivo: ");
    Serial.println(MAC_DISPOSITIVO);
  }

  ligarWiFi();

  Serial.println();
  Serial.println("SMART CLIMATE INICIADO (ARDUINO FISICO)");
  Serial.println("Controlo da ventoinha: ON/OFF");
  Serial.println("Modo inicial: automatico");
}


void loop() {
  ligarWiFi();

  processarBotao();

  unsigned long agora = millis();

  // ler a temperatura de 5 em 5 segundos
  if (!temLeitura || agora - ultimaLeituraTemperatura >= INTERVALO_LEITURA) {
    temperatura = lerTemperatura();
    ultimaLeituraTemperatura = millis();
    temLeitura = true;

    Serial.print("Temperatura: ");
    Serial.print(temperatura, 2);
    Serial.println(" C");
  }

  controlarSistema();

  // em standby os dois leds piscam
  if (standby) {
    if (agora - ultimoPiscar >= 300) {
      ultimoPiscar = agora;
      ledsLigados = !ledsLigados;
    }

    digitalWrite(LED_VERDE, ledsLigados ? HIGH : LOW);
    digitalWrite(LED_VERMELHO, ledsLigados ? HIGH : LOW);
  }

  // enviar para a api
  if (enviarImediatamente ||
      ultimoEnvioAPI == 0 ||
      agora - ultimoEnvioAPI >= INTERVALO_API) {

    // tem de ser antes, porque enviarTemperatura pode pôr a true outra vez
    enviarImediatamente = false;

    enviarTemperatura();

    ultimoEnvioAPI = millis();
  }

  delay(10);
}
