String lerCampoJSON(String json, String campo);


// ================================================
// LIGAR WI-FI
// ================================================

void ligarWiFi() {

  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  if (wifiIniciado &&
      millis() - ultimaTentativaWiFi < 10000UL) {
    return;
  }

  ultimaTentativaWiFi = millis();
  wifiIniciado = true;

  Serial.println("A ligar ao Wi-Fi...");

  WiFi.begin(WIFI_SSID, WIFI_PASS);
}


// ================================================
// LER TEMPERATURA - TMP36
// ================================================

float lerTemperatura() {

  int valorADC = analogRead(SENSOR);

  // Arduino UNO R4 WiFi: ADC de 14 bits
  float tensao = valorADC * 5000.0 / 16383.0;

  // TMP36: 500 mV a 0 graus Celsius
  return (tensao - 500.0) / 10.0;
}


// ================================================
// EXTRAIR UM CAMPO DE UM JSON
// ================================================

String lerCampoJSON(String json, String campo) {

  String chave = "\"" + campo + "\"";

  int posicao = json.indexOf(chave);

  if (posicao < 0) {
    return "";
  }

  int doisPontos = json.indexOf(
    ':',
    posicao + chave.length()
  );

  if (doisPontos < 0) {
    return "";
  }

  int inicio = doisPontos + 1;

  while (inicio < json.length() &&
         (json.charAt(inicio) == ' ' ||
          json.charAt(inicio) == '\n' ||
          json.charAt(inicio) == '\r' ||
          json.charAt(inicio) == '\t')) {
    inicio++;
  }

  // Valor em formato de texto
  if (json.charAt(inicio) == '"') {

    int fim = json.indexOf('"', inicio + 1);

    if (fim < 0) {
      return "";
    }

    return json.substring(inicio + 1, fim);
  }

  // Valor booleano ou numérico
  int fim = inicio;

  while (fim < json.length() &&
         json.charAt(fim) != ',' &&
         json.charAt(fim) != '}' &&
         json.charAt(fim) != ']') {
    fim++;
  }

  String valor = json.substring(inicio, fim);
  valor.trim();

  return valor;
}


// ================================================
// EXTRAIR O OBJETO "actuators" DA RESPOSTA
// ================================================

String extrairObjetoJSON(String json, String campo) {

  String chave = "\"" + campo + "\"";

  int posicao = json.indexOf(chave);

  if (posicao < 0) {
    return "";
  }

  int inicio = json.indexOf('{', posicao);

  if (inicio < 0) {
    return "";
  }

  int fim = json.indexOf('}', inicio);

  if (fim < 0) {
    return "";
  }

  return json.substring(inicio, fim + 1);
}


// ================================================
// RECEBER COMANDOS DA APLICAÇÃO
// ================================================


bool receberComandos(String resposta) {

  String atuadores = extrairObjetoJSON(
    resposta,
    "actuators"
  );

  if (atuadores.length() == 0) {
    Serial.println("ERRO: resposta sem objeto actuators.");
    return false;
  }

  // O modo manual foi retirado, por isso já não lemos o "mode".
  // Agora só interessam estes dois comandos da app:
  String novoEstado = lerCampoJSON(
    atuadores,
    "fan_on"
  );

  String novoStandby = lerCampoJSON(
    atuadores,
    "standby"
  );

  if (novoEstado.length() == 0 || novoStandby.length() == 0) {
    Serial.println("ERRO: comandos incompletos.");
    return false;
  }

  comandoVentoinhaLigada = (novoEstado == "true");

  bool standbyDaApp = (novoStandby == "true");

  // Se o standby mudou pela app, começa a piscar do zero
  if (standbyDaApp != standby) {

    standby = standbyDaApp;

    ledsLigados = false;

    ultimoPiscar = millis();

    Serial.println(
      standby ? "STANDBY ATIVADO PELA APP" : "STANDBY DESATIVADO PELA APP"
    );
  }

  Serial.println("----------------------------");
  Serial.println("COMANDOS RECEBIDOS DA APP");

  Serial.print("Ventoinha: ");
  Serial.println(
    comandoVentoinhaLigada ? "PERMITIDA (AUTOMATICO)" : "DESLIGADA PELA APP"
  );

  Serial.print("Standby: ");
  Serial.println(standby ? "SIM" : "NAO");

  Serial.println("----------------------------");

  return true;
}

// ================================================
// CONTROLAR VENTOINHA E LEDS
// ================================================

void controlarSistema() {

  bool ligarVentoinha = false;

  // STANDBY
  if (standby) {

    digitalWrite(RELE, LOW);
    ventoinhaLigadaReal = false;

    return;
  }

  // MODO AUTOMATICO
  // A ventoinha só liga se a app deixar (fan_on = true)
  // E se a temperatura passar o limite.
  // Se a app mandar desligar, fica desligada seja qual for a temperatura.
  ligarVentoinha = comandoVentoinhaLigada &&
                   temperatura > LIMITE_TEMPERATURA;

  // CONTROLAR RELE
  digitalWrite(RELE, ligarVentoinha ? HIGH : LOW);

  ventoinhaLigadaReal = ligarVentoinha;

  // LEDS DE TEMPERATURA
  if (temperatura > LIMITE_TEMPERATURA) {

    digitalWrite(LED_VERDE, LOW);
    digitalWrite(LED_VERMELHO, HIGH);
  }

  else {

    digitalWrite(LED_VERDE, HIGH);
    digitalWrite(LED_VERMELHO, LOW);
  }
}

// ================================================
// ENVIAR TEMPERATURA E RECEBER COMANDOS
// ================================================

void enviarTemperatura() {

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi desligado.");
    return;
  }
  
HTTPClient http;

http.begin(API_URL);

  http.addHeader("Content-Type", "application/json");

  http.addHeader(
    "Authorization",
    String("Bearer ") + API_TOKEN
  );

  String json = "{\"sensor\":\"TMP36\",\"value\":";
  json += String(temperatura, 2);

  json += ",\"mac\":\"";
  json += MAC_DISPOSITIVO;
  json += "\"";

  json += ",\"device_token\":\"";
  json += API_TOKEN;
  json += "\"";

  // Estado REAL da ventoinha (antes chamava-se "fan_on", mas isso
  // apagava o comando da app na base de dados)
  json += ",\"fan_actual_on\":";
  json += (ventoinhaLigadaReal ? "true" : "false");

  json += ",\"led_1\":";
  json += (digitalRead(LED_VERDE) ? "true" : "false");

  json += ",\"led_2\":";
  json += (digitalRead(LED_VERMELHO) ? "true" : "false");

  // Só mandamos o standby quando foi o botão físico a mudá-lo
  if (standbyPendente) {
    json += ",\"standby\":";
    json += (standby ? "true" : "false");
  }

  json += "}";

  Serial.println("A enviar dados para a API...");
  Serial.println(json);

  int codigoHTTP = http.POST(json);

  Serial.print("Codigo HTTP: ");
Serial.println(codigoHTTP);

if (codigoHTTP < 0) {
    Serial.print("Descricao: ");
    Serial.println(HTTPClient::errorToString(codigoHTTP));
}

  Serial.print("Resposta HTTP: ");
  Serial.println(codigoHTTP);

  String resposta = http.getString();

  Serial.println("Resposta da API:");
  Serial.println(resposta);

  if (codigoHTTP == 201 || codigoHTTP == 200) {

    // A API já guardou o standby do botão físico
    standbyPendente = false;

    // Guardar o estado antes dos comandos para ver se mudou algo
    bool ventoinhaAntes = ventoinhaLigadaReal;
    bool standbyAntes = standby;

    if (receberComandos(resposta)) {
      controlarSistema();

      Serial.println("Comandos aplicados no Arduino.");

      // Se a app mudou alguma coisa, voltamos a enviar logo
      // para a app ver o novo estado real (sem esperar 5 s)
      if (ventoinhaLigadaReal != ventoinhaAntes ||
          standby != standbyAntes) {
        enviarImediatamente = true;
      }
    }
  }

  else {
    Serial.println("Erro na comunicacao com a API.");
  }

  http.end();
}


// ================================================
// BOTAO LOCAL - STANDBY
// ================================================

void processarBotao() {

  bool leitura = digitalRead(BOTAO);

  unsigned long agora = millis();

  if (leitura != ultimaLeituraBotao) {

    ultimaLeituraBotao = leitura;

    ultimaMudancaBotao = agora;
  }

  if (agora - ultimaMudancaBotao >= 50) {

    if (leitura != estadoBotao) {

      estadoBotao = leitura;

      if (estadoBotao == HIGH) {
        botaoArmado = true;
      }

      if (estadoBotao == LOW && botaoArmado) {

        botaoArmado = false;

        standby = !standby;

        ledsLigados = false;

        ultimoPiscar = agora;

        // Avisar a API logo a seguir para a app ficar igual ao Mokxi
        standbyPendente = true;

        enviarImediatamente = true;

        if (standby) {

          Serial.println("STANDBY ATIVO (BOTAO)");
        }

        else {

          temLeitura = false;

          Serial.println("STANDBY DESATIVADO (BOTAO)");
        }

        controlarSistema();
      }
    }
  }
}


// ================================================
// SETUP
// ================================================

void setup() {

  Serial.begin(115200);

  analogReadResolution(14);

  pinMode(BOTAO, INPUT_PULLUP);

  pinMode(LED_VERDE, OUTPUT);
  pinMode(LED_VERMELHO, OUTPUT);

pinMode(RELE, OUTPUT);

  digitalWrite(LED_VERDE, LOW);
  digitalWrite(LED_VERMELHO, LOW);

  digitalWrite(RELE, LOW);

  estadoBotao = digitalRead(BOTAO);

  ultimaLeituraBotao = estadoBotao;

  botaoArmado = (estadoBotao == HIGH);

  ultimaMudancaBotao = millis();

  ligarWiFi();

  Serial.println();
  Serial.println("SMART CLIMATE INICIADO");
  Serial.println("Controlo da ventoinha: ON/OFF");
  Serial.println("Modo inicial: automatico");
}

// ================================================
// LOOP
// ================================================

void loop() {

  ligarWiFi();

  processarBotao();

  unsigned long agora = millis();

  // Ler temperatura
  if (!temLeitura ||
      agora - ultimaLeituraTemperatura >= INTERVALO_LEITURA) {

    temperatura = lerTemperatura();

    ultimaLeituraTemperatura = millis();

    temLeitura = true;

    Serial.print("Temperatura: ");

    Serial.print(temperatura, 2);

    Serial.println(" C");
  }

  // Aplicar os comandos atuais (app + temperatura)
  controlarSistema();

  // Standby: piscar os dois LEDs
  if (standby) {

    if (agora - ultimoPiscar >= 300) {

      ultimoPiscar = agora;

      ledsLigados = !ledsLigados;
    }

    digitalWrite(
      LED_VERDE,
      ledsLigados ? HIGH : LOW
    );

    digitalWrite(
      LED_VERMELHO,
      ledsLigados ? HIGH : LOW
    );
  }

  // Enviar temperatura e consultar comandos
  if (enviarImediatamente ||
      ultimoEnvioAPI == 0 ||
      agora - ultimoEnvioAPI >= INTERVALO_API) {

    // Pomos a false ANTES de enviar, porque o enviarTemperatura()
    // pode voltar a pô-la a true se a app tiver mudado alguma coisa
    enviarImediatamente = false;

    enviarTemperatura();

    ultimoEnvioAPI = millis();
  }

  delay(10);
}
