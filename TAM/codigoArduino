
void enviarTemperatura() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi desligado.");
    return;
  }

  HTTPClient http;

  if (!http.begin(API_URL)) {
    Serial.println("Erro ao iniciar pedido.");
    return;
  }

  http.addHeader("Content-Type", "application/json");

  const char aspas = 34;

  // Obter o estado atual dos componentes
  bool fanReal = !standby &&
                 modoAtual != "noturno" &&
                 ventoinhaLigadaAPI &&
                 velocidadeAPI > 0;

  bool ledVerdeReal = digitalRead(LED_VERDE) == HIGH;
  bool ledVermelhoReal = digitalRead(LED_VERMELHO) == HIGH;

  // Construir JSON
  String json = "{";

  json += aspas;
  json += "sensor";
  json += aspas;
  json += ":";
  json += aspas;
  json += "TMP36";
  json += aspas;
  json += ",";

  json += aspas;
  json += "value";
  json += aspas;
  json += ":";
  json += String(temperatura, 2);
  json += ",";

  json += aspas;
  json += "device_token";
  json += aspas;
  json += ":";
  json += aspas;
  json += API_TOKEN;
  json += aspas;
  json += ",";

  json += aspas;
  json += "mac";
  json += aspas;
  json += ":";
  json += aspas;
  json += MAC_DEVICE;
  json += aspas;
  json += ",";

  // Estado da ventoinha
  json += aspas;
  json += "fan_on";
  json += aspas;
  json += ":";
  json += (fanReal ? "true" : "false");
  json += ",";

  // Estado do LED verde
  json += aspas;
  json += "led_1";
  json += aspas;
  json += ":";
  json += (ledVerdeReal ? "true" : "false");
  json += ",";

  // Estado do LED vermelho
  json += aspas;
  json += "led_2";
  json += aspas;
  json += ":";
  json += (ledVermelhoReal ? "true" : "false");

  json += "}";

  Serial.println("A enviar temperatura...");

  int codigoHTTP = http.POST(json);

  Serial.print("Resposta HTTP: ");
  Serial.println(codigoHTTP);

  String resposta = http.getString();

  if (codigoHTTP == 201) {
    receberComandos(resposta);

    Serial.println("Comandos recebidos da API.");
  } else {
    Serial.println(resposta);
  }

  http.end();
}
