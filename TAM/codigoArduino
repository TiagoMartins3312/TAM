// Pinos
const int SENSOR = A0;
const int BOTAO = 2;
const int LED_VERDE = 3;
const int LED_VERMELHO = 4;
const int RELE = 5;

// Temperatura limite do modo automático
const float LIMITE_TEMPERATURA = 20.0;

// Intervalos
const unsigned long INTERVALO_LEITURA = 5000UL;
// Baixámos de 10 s para 5 s para a app responder mais depressa
const unsigned long INTERVALO_API = 5000UL;

// Comunicação
unsigned long ultimaTentativaWiFi = 0;
unsigned long ultimaLeituraTemperatura = 0;
unsigned long ultimoEnvioAPI = 0;

bool wifiIniciado = false;
bool temLeitura = false;
bool enviarImediatamente = true;

// Estado do sistema
float temperatura = 0.0;

// Comando da app: true = ventoinha pode ligar (automático pela temperatura)
//                 false = ventoinha desligada pela app
bool comandoVentoinhaLigada = false;
bool ventoinhaLigadaReal = false;

// Standby (pode vir da app ou do botão físico)
bool standby = false;
bool ledsLigados = false;

// Fica true quando o botão físico muda o standby e ainda
// não avisámos a API (para a app não o desfazer logo a seguir)
bool standbyPendente = false;

bool ultimaLeituraBotao = HIGH;
bool estadoBotao = HIGH;
bool botaoArmado = false;

unsigned long ultimaMudancaBotao = 0;
unsigned long ultimoPiscar = 0;


// ================================================
// PROTOTIPOS
// ================================================

void ligarWiFi();
float lerTemperatura();
void controlarSistema();
void enviarTemperatura();
